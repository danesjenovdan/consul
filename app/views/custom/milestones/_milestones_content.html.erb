<% milestones = milestoneable.milestones.by_locale.order_by_publication_date %>
<div class="row">
  <div class="small-12 medium-10 medium-centered">
    <%= render Milestones::ProgressBarsComponent.new(milestoneable) %>

    <% if milestones.blank? %>
      <div class="callout primary text-center margin-top">
        <%= t("milestones.index.no_milestones") %>
      </div>
    <% end %>

    <section class="timeline">
      <ul class="no-bullet">
        <% milestones.each do |milestone| %>
          <%= render "milestones/milestone", milestone: milestone %>
        <% end %>
      </ul>
    </section>
  </div>
</div>
