var updated = $("<%= j render(Proposals::FeedbackComponent.new(params[:resource_type], @feedback)) %>");
var box = $(".proposal-feedback");
var button = box.find(".js-proposal-feedback");

if (updated.length > 0) {
  box.find(".proposal-feedback-results").html(updated.find(".proposal-feedback-results").html());
  button.text(updated.find(".js-proposal-feedback").text());
} else {
  App.ProposalFeedback.showError(box);
}

button.prop("disabled", false).removeClass("is-loading").focus();
